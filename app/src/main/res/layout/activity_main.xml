<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/ink"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/itemCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/ink_dim"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/remoteHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/remote_hint"
        android:textColor="@color/accent"
        android:textSize="11sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/searchBox"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_search"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:hint="@string/search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/ink_dim"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSelectAll"
            style="@style/Tiqu.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:focusable="true"
            android:text="@string/select_all"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnClear"
            style="@style/Tiqu.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:focusable="true"
            android:text="@string/clear_selection"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 列表区 + 刷新 loading 遮罩 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/appList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:drawSelectorOnTop="true"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/no_apps"
            android:textColor="@color/ink_dim"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/loadingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent" />

            <TextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/loading_apps"
                android:textColor="@color/ink_dim"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 底部：圆角卡片，高度收紧 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_bottom_card"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/selectedCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/selected_count"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnExtract"
            style="@style/Tiqu.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:focusable="true"
            android:minWidth="112dp"
            android:text="@string/extract_selected"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/savePathView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/ink_dim"
        android:textSize="11sp" />
</LinearLayout>
